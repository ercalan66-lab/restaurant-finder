{
  "expo": {
    "name": "Fork",
    "slug": "restaurant-finder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fork-app-icon.png",
    "scheme": "restaurantfinder",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/fork-app-icon.png",
      "bundleIdentifier": "com.forktz.app"
    },
    "android": {
      "package": "com.forktz.app",
      "adaptiveIcon": {
        "backgroundColor": "#FDC52B",
        "foregroundImage": "./assets/images/fork-app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDC52B",
          "image": "./assets/images/fork-app-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fork uses your photos so you can add pictures of your restaurant and dishes.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ED6417",
          "defaultChannel": "default"
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "dd5902e9-4b12-4781-a779-031f346345d0"
      }
    },
    "owner": "erickallanmbuya"
  }
}
